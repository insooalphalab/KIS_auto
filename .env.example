# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요. (.env 는 git 에 올라가지 않습니다)

# 한국투자증권 Open API (https://apiportal.koreainvestment.com)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=

# 텔레그램 봇 (@BotFather 에서 토큰, @userinfobot 에서 chat id 확인)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude Code CLI 전체 경로 (작업 스케줄러 자동 실행용. `where claude` 로 확인, 예: npm 전역 폴더의 claude.cmd)
CLAUDE_CLI=

# 월간 매크로/섹터 분석용
FRED_API_KEY=
CUSTOMS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
